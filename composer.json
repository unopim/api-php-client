{
    "name": "unopim/api-php-client",
    "description": "Official PHP API client for the UnoPim PIM — authenticate, paginate, and manage products, categories, attributes, families, channels, locales, and assets. Framework-agnostic, PSR-18 compatible.",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "unopim",
        "pim",
        "php",
        "api-client",
        "rest-api",
        "psr-18",
        "oauth2",
        "product-information-management"
    ],
    "homepage": "https://github.com/unopim/api-php-client",
    "support": {
        "issues": "https://github.com/unopim/api-php-client/issues",
        "source": "https://github.com/unopim/api-php-client",
        "docs":   "https://docs.unopim.com"
    },
    "authors": [
        {
            "name": "Webkul Software Pvt. Ltd.",
            "email": "support@webkul.com",
            "homepage": "https://webkul.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "^7.0 — popular PSR-18 HTTP client",
        "guzzlehttp/psr7": "^2.0 — Guzzle PSR-7 implementation",
        "symfony/http-client": "^6.0|^7.0 — Symfony PSR-18 HTTP client",
        "nyholm/psr7": "^1.0 — lightweight PSR-7 implementation"
    },
    "autoload": {
        "psr-4": {
            "Unopim\\ApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unopim\\ApiClient\\Tests\\": "tests/"
        }
    },
    "replace": {
        "webkul/unopim-php-sdk": "self.version",
        "unopim/api-php-sdk":    "self.version"
    },
    "scripts": {
        "test":     "vendor/bin/pest",
        "test:cov": "vendor/bin/pest --coverage",
        "stan":     "vendor/bin/phpstan analyse src --level=5",
        "cs":       "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix":   "vendor/bin/php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
